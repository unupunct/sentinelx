<UserControl x:Class="SentinelX.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SentinelX.App.Controls"
             xmlns:vm="clr-namespace:SentinelX.App.ViewModels">
    <ScrollViewer Background="{DynamicResource BgPrimaryBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,20"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ScoreGaugeControl Grid.Column="0" Score="{Binding OverallScore}" />

                    <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                        <TextBlock Text="Overall Stability" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimaryBrush}" />
                        <TextBlock Text="{Binding LastScanText}" FontSize="13"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="Historical trend" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}"
                                   Margin="0,16,0,4" />
                        <controls:SparklineControl Values="{Binding HistoryTrend}" Width="300" Height="46" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Run Scan" Command="{Binding RunScanCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>
            </Border>

            <TextBlock Text="Subsystem Health" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimaryBrush}" Margin="4,0,0,12" />

            <ItemsControl ItemsSource="{Binding HealthCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthCardViewModel}">
                        <controls:HealthCardControl Margin="0,0,16,16" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
