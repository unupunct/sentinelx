<UserControl x:Class="SentinelX.App.Views.LiveMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SentinelX.App.Controls"
             xmlns:monitoring="clr-namespace:SentinelX.Infrastructure.Monitoring;assembly=SentinelX.Infrastructure">
    <ScrollViewer Background="{DynamicResource BgPrimaryBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <TextBlock Text="Live Monitoring" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,20" />

            <UniformGrid Columns="3" Rows="1">
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="20"
                        Margin="0,0,10,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="System" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimaryBrush}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:0}}" />
                                    <Run Text="%" FontSize="12" />
                                </TextBlock>
                                <controls:SparklineControl Values="{Binding CpuSamples}" Height="26" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding MemoryUsagePercent, Mode=OneWay, StringFormat={}{0:0}}" />
                                    <Run Text="%" FontSize="12" />
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="{DynamicResource FgSecondaryBrush}">
                                    <Run Text="{Binding MemoryUsedGb, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding MemoryTotalGb, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text=" GB" />
                                </TextBlock>
                                <controls:SparklineControl Values="{Binding MemorySamples}" Height="26" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="GPU" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding GpuUsagePercent, Mode=OneWay, StringFormat={}{0:0}}" />
                                    <Run Text="%" FontSize="12" />
                                </TextBlock>
                                <controls:SparklineControl Values="{Binding GpuSamples}" Height="26" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding GpuUnavailableReason}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="20"
                        Margin="10,0,10,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Network" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimaryBrush}" />
                        <TextBlock Text="{Binding AdapterDescription}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ConnectionSummary}" FontSize="12"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Upload" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding UploadMbps, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" />
                                </TextBlock>
                                <controls:SparklineControl Values="{Binding UploadSamples}" Height="30" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="Download" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding DownloadMbps, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" />
                                </TextBlock>
                                <controls:SparklineControl Values="{Binding DownloadSamples}" Height="30" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="20"
                        Margin="10,0,0,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OBS Live" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimaryBrush}" />
                            <Border Grid.Column="1" CornerRadius="10" Padding="9,3"
                                    Background="{Binding ObsStreaming, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=AccentGreenBrush|AccentOrangeBrush}">
                                <TextBlock Text="{Binding ObsStatusText}" FontWeight="Bold" Foreground="White" FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Skipped Frames" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding ObsSkippedFramesPercent, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text="%" FontSize="12" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Congestion" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding ObsCongestionPercent, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                    <Run Text="%" FontSize="12" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bitrate Out" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}">
                                    <Run Text="{Binding ObsKbpsOut, Mode=OneWay, StringFormat={}{0:0}}" />
                                    <Run Text=" kbps" FontSize="12" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Watched Processes" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimaryBrush}" Margin="4,4,0,12" />

            <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="14" Padding="18"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Processes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type monitoring:ProcRow}">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource FgPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13"
                                           Foreground="{Binding IsRunning, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=FgPrimaryBrush|FgSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
