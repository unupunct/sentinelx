<Window x:Class="SentinelX.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SentinelX.App.Views"
        Title="Sentinel X"
        Icon="/Assets/app.ico"
        Height="860" Width="1320" MinHeight="600" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgPrimaryBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource BgPanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Sentinel X" Margin="16,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource FgPrimaryBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Theme" Width="70" Height="48" Style="{StaticResource TitleBarButtonStyle}"
                            Command="{Binding ToggleThemeCommand}" />
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Height="48"
                            Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" Height="48"
                            Click="OnCloseClick" Style="{StaticResource TitleBarButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,16">
                        <Button Content="Dashboard" Command="{Binding SelectDashboardCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavPillButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Live Monitoring" Command="{Binding SelectLiveMonitoringCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavPillButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveMonitoringSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Event Viewer" Command="{Binding SelectEventViewerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavPillButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEventViewerSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Speed Test" Command="{Binding SelectSpeedTestCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavPillButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSpeedTestSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <!-- Visibility is bound on a wrapper, not the view itself: the view's own
                         DataContext="{Binding ...}" below reassigns DataContext for that
                         element and its descendants, so a Visibility binding on the same
                         element would resolve against the child ViewModel (which has no
                         IsDashboardSelected/IsLiveMonitoringSelected/IsEventViewerSelected/
                         IsSpeedTestSelected property) instead of MainWindowViewModel, silently
                         failing and defaulting to Visible. -->
                    <Grid Visibility="{Binding IsDashboardSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:DashboardView DataContext="{Binding Dashboard}" />
                    </Grid>
                    <Grid Visibility="{Binding IsLiveMonitoringSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:LiveMonitoringView DataContext="{Binding LiveMonitoring}" />
                    </Grid>
                    <Grid Visibility="{Binding IsEventViewerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:EventViewerView DataContext="{Binding EventViewer}" />
                    </Grid>
                    <Grid Visibility="{Binding IsSpeedTestSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:SpeedTestView DataContext="{Binding SpeedTest}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
