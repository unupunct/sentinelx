<UserControl x:Class="SentinelX.App.Views.EventViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SentinelX.App.ViewModels"
             xmlns:eventlog="clr-namespace:SentinelX.Infrastructure.EventLog;assembly=SentinelX.Infrastructure">
    <Grid Background="{DynamicResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,28,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Event Viewer" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />

                <ComboBox Grid.Column="1" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding LookbackOptions}" SelectedItem="{Binding SelectedLookback}"
                          DisplayMemberPath="Label" />

                <ComboBox Grid.Column="2" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding LevelFilterOptions}" SelectedItem="{Binding SelectedLevelFilter}"
                          DisplayMemberPath="Label" />

                <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" Background="{DynamicResource AccentRedBrush}">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding CriticalCount, Mode=OneWay}" />
                        <Run Text=" Critical" />
                    </TextBlock>
                </Border>
                <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" Background="{DynamicResource AccentOrangeBrush}">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding ErrorCount, Mode=OneWay}" />
                        <Run Text=" Error" />
                    </TextBlock>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" Background="{DynamicResource DividerBrush}">
                    <TextBlock Foreground="{DynamicResource FgPrimaryBrush}" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding WarningCount, Mode=OneWay}" />
                        <Run Text=" Warning" />
                    </TextBlock>
                </Border>

                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource FgSecondaryBrush}" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="28,0,28,28" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type eventlog:EventEntry}">
                        <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="10" Padding="16"
                                Margin="0,0,0,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="8" Padding="8,2" Margin="0,0,10,0"
                                            Background="{Binding Level, Converter={StaticResource EventLevelToBrushConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="10" />
                                    </Border>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimaryBrush}">
                                        <Run Text="{Binding ProviderName, Mode=OneWay}" />
                                        <Run Text=" (Event " />
                                        <Run Text="{Binding Id, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource FgSecondaryBrush}">
                                        <Run Text="{Binding LogName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding TimeCreated, Mode=OneWay, StringFormat={}{0:g}}" />
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,10,0,0" />

                                <TextBlock Text="{Binding KnownExplanation}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding KnownExplanation, Converter={StaticResource StringToVisibilityConverter}}" />
                                <TextBlock Text="{Binding RecommendedAction}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBlueBrush}" FontStyle="Italic" Margin="0,4,0,0"
                                           Visibility="{Binding RecommendedAction, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
